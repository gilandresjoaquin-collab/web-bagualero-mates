# ==========================================================
#  Web Bagualero Mates — archivos que NO se suben al repo
# ==========================================================

# --- Credenciales y configuración local ---
.env
.env.*
!.env.example
server/config/config.php

# --- Dependencias instaladas ---
node_modules/
vendor/

# --- Imágenes subidas por el administrador desde el panel ---
server/uploads/*
!server/uploads/.gitkeep

# --- Logs y temporales ---
*.log
*.tmp
*.cache

# --- Respaldos de base de datos con datos reales ---
*.sql.bak
dump_*.sql

# --- Editores / IDE ---
.vscode/
.idea/
*.code-workspace

# --- Sistema operativo ---
Thumbs.db
desktop.ini
.DS_Store
